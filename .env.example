APP_NAME=AttendPro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=attendpro
DB_USERNAME=root
DB_PASSWORD=

ATTENDPRO_ADMIN_EMAIL=attendance.admin@hccd.edu.ph
ATTENDPRO_ADMIN_PASSWORD=
ATTENDPRO_STAFF_EMAIL=attendance.staff@hccd.edu.ph
ATTENDPRO_STAFF_PASSWORD=
ATTENDPRO_REVIEWER_EMAIL=attendance.reviewer@hccd.edu.ph
ATTENDPRO_REVIEWER_PASSWORD=
ATTENDPRO_MIN_CONFIDENCE=0.65
ATTENDPRO_MIN_SECOND_BEST_MARGIN=0.04
ATTENDPRO_FRAME_WINDOW=7
ATTENDPRO_MIN_CONSISTENT_MATCHES=5
ATTENDPRO_ENROLLMENT_SAMPLES=15
ATTENDPRO_RETAIN_ENROLLMENT_IMAGES=true
ATTENDPRO_MAX_BATCH_IMAGES=30
ATTENDPRO_ENROLLMENT_MAX_SIMILARITY=0.9999
ATTENDPRO_ATTENDANCE_EMAIL_NOTIFICATIONS=true
ATTENDPRO_MIN_FACE_WIDTH=120
ATTENDPRO_MIN_FACE_HEIGHT=120
ATTENDPRO_MIN_BLUR_SCORE=45
ATTENDPRO_MIN_BRIGHTNESS=45
ATTENDPRO_MAX_BRIGHTNESS=210
ATTENDPRO_MAX_ROLL=18
ATTENDPRO_MAX_YAW_PROXY=0.38
ATTENDPRO_MAX_PITCH_PROXY=0.32
ATTENDPRO_FACE_SYNC_PAGE_SIZE=250
ATTENDPRO_DUPLICATE_SCAN_SECONDS=60
ATTENDPRO_PUBLIC_ATTENDANCE_ENABLED=true
ATTENDPRO_PUBLIC_ATTENDANCE_ALLOWED_IPS=127.0.0.1,::1
ATTENDPRO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
ATTENDPRO_PYTHON_URL=http://127.0.0.1:5001
ATTENDPRO_PYTHON_SERVICE_KEY=
ATTENDPRO_PYTHON_TIMEOUT=30
ATTENDPRO_PYTHON_MANAGED=true
ATTENDPRO_LARAVEL_API_URL=http://127.0.0.1:8000/api/v1
ATTENDPRO_PYTHON_HOST=127.0.0.1
ATTENDPRO_PYTHON_PORT=5001
ATTENDPRO_PYTHON_SYNC_SECONDS=60
ATTENDPRO_PYTHON_REQUEST_TIMEOUT=15
ATTENDPRO_PYTHON_MAX_IMAGE_MB=5
ATTENDPRO_PYTHON_DETECTION_SCORE=0.85
ATTENDPRO_PYTHON_MIN_FACE_RATIO=0.12
# Face backend: insightface (default, insightface-master buffalo_l SCRFD+ArcFace),
# sface (OpenCV YuNet+SFace), or dlib (face_recognition-master).
# Switching backends changes the embedding space, so re-enroll faces afterwards.
ATTENDPRO_FACE_BACKEND=insightface
ATTENDPRO_DLIB_DETECTOR=hog
ATTENDPRO_DLIB_UPSAMPLE=1
ATTENDPRO_DLIB_JITTERS=1
ATTENDPRO_INSIGHTFACE_PACK=buffalo_l
ATTENDPRO_INSIGHTFACE_DET_SIZE=640
ATTENDPRO_INSIGHTFACE_CTX_ID=-1

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
# Gmail SMTP uses MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, and MAIL_REQUIRE_TLS=true.
# MAIL_USERNAME is the Gmail account. MAIL_PASSWORD is a Gmail App Password, never the normal Gmail password.
# MAIL_FROM_ADDRESS is normally the same Gmail account.
MAIL_SCHEME=smtp
MAIL_REQUIRE_TLS=true
MAIL_TIMEOUT=10
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth credentials come from a Google Cloud OAuth Web Application.
# GOOGLE_CLIENT_ID is the Google OAuth Client ID. GOOGLE_CLIENT_SECRET is the Google OAuth Client Secret.
# GOOGLE_REDIRECT_URI must exactly match the callback URL registered in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
