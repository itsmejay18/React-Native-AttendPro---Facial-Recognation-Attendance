# Usually these are kept in the repository root .env so Laravel and Python share them.
ATTENDPRO_LARAVEL_API_URL=http://127.0.0.1:8000/api/v1
ATTENDPRO_PYTHON_SERVICE_KEY=replace-with-a-long-random-secret
ATTENDPRO_PYTHON_HOST=127.0.0.1
ATTENDPRO_PYTHON_PORT=5001
ATTENDPRO_PYTHON_MODEL_DIR=
ATTENDPRO_PYTHON_SYNC_SECONDS=60
ATTENDPRO_PYTHON_REQUEST_TIMEOUT=15
ATTENDPRO_PYTHON_MAX_IMAGE_MB=5
ATTENDPRO_PYTHON_DETECTION_SCORE=0.85
ATTENDPRO_PYTHON_MIN_FACE_RATIO=0.12
# Face backend: insightface (default, buffalo_l pack: SCRFD + ArcFace R100),
# sface (OpenCV YuNet+SFace, lightweight), or dlib (face_recognition-master,
# dlib ResNet 99.38% LFW, needs requirements-dlib.txt).
ATTENDPRO_FACE_BACKEND=insightface
ATTENDPRO_DLIB_DETECTOR=hog
ATTENDPRO_DLIB_UPSAMPLE=1
ATTENDPRO_DLIB_JITTERS=1
